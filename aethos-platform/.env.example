# Application
SECRET_KEY=your-secure-secret-key
PROJECT_NAME=Aethos Platform
API_V1_STR=/api/v1

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Azure Authentication
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group

# Azure AI Services
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_AI_AGENT_SERVICE_ENDPOINT=https://your-ai-agent-service.azure.com

GLOBAL_LLM_SERVICE=AzureOpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
PROJECT_CONNECTION_STRING=
GITHUB_TOKEN=
AZURE_SEARCH_SERVICE_ENDPOINT = 
AZURE_SUBSCRIPTION_ID=
AZURE_AI_PROJECT_NAME=
AZURE_OPENAI_RESOURCE_GROUP=
AZURE_OPENAI_SERVICE=
AZURE_AI_AGENT_SERVICE_ENDPOINT=https://your-ai-agent-service.azure.com


# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_BLOB_CONTAINER_NAME=agent-files

# Azure SQL Database
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USERNAME=your-sql-username
AZURE_SQL_PASSWORD=your-sql-password

For local development with docker-compose
DATABASE_URL is automatically constructed from the above SQL settings
# or you can set it explicitly:
DATABASE_URL=mssql+pyodbc://username:password@server/database?driver=ODBC+Driver+17+for+SQL+Server

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days